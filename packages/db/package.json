{
  "name": "@madar/db",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./tenant": {
      "types": "./src/tenant.ts",
      "default": "./dist/src/tenant.js"
    },
    "./admin": {
      "types": "./src/admin.ts",
      "default": "./dist/src/admin.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./dist/src/types.js"
    }
  },
  "types": "./src/index.ts",
  "main": "./dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "node prisma/run-prisma.mjs generate",
    "db:migrate": "node prisma/run-prisma.mjs migrate dev",
    "db:migrate:deploy": "node prisma/run-prisma.mjs migrate deploy",
    "db:reset": "node prisma/run-prisma.mjs migrate reset --force",
    "db:studio": "node prisma/run-prisma.mjs studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:bootstrap-admin": "tsx prisma/bootstrap-admin.ts",
    "test:rls": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "argon2": "^0.41.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "dotenv": "^16.4.5",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
